# Copie este contenido en Streamlit Cloud > Manage app > Settings > Secrets
# (o en .streamlit/secrets.toml para pruebas en el computador; ese archivo NO se sube a GitHub).

[docente]
clave = "SU-CLAVE-PERSONAL"

[registro]
# ID de la Google Sheet: la parte de la URL entre /d/ y /edit
sheet_id = "PEGUE-AQUI-EL-ID-DE-LA-HOJA"
pestana = "Sesiones_2027_S_1"

# Pegue ENTRE las tres comillas simples el contenido COMPLETO del archivo .json
# descargado de Google Cloud (desde la llave { hasta la llave }), sin modificarlo.
gcp_json = '''
{ "type": "service_account", "...": "..." }
'''
