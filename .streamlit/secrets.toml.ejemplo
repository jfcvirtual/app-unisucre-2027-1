# Copie este archivo como .streamlit/secrets.toml (en local)
# o péguelo en Streamlit Cloud > App > Settings > Secrets.

[docente]
clave = "CAMBIE-ESTA-CLAVE"

[registro]
# ID de la Google Sheet: es la parte de la URL entre /d/ y /edit
sheet_id = "PEGUE-AQUI-EL-ID-DE-LA-HOJA"
pestaña = "Sesiones_2027_S_1"

[gcp_service_account]
# Contenido del archivo JSON de la cuenta de servicio de Google Cloud
type = "service_account"
project_id = ""
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "nombre@proyecto.iam.gserviceaccount.com"
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
